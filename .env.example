# Copia este archivo a .env (cp .env.example .env). Valores solo para desarrollo.
#
# Puertos: usamos valores poco comunes (53000/53001/55432/56379) para no chocar
# con los puertos por defecto (3000/3001/5432/6379) que suelen usar OTROS
# proyectos en esta misma máquina. Si aun así alguno está ocupado, cambia el
# número aquí y vuelve a correr `docker compose up --build`: Docker avisa solo
# con un error "port is already allocated" si el puerto sigue en conflicto.

# PostgreSQL
POSTGRES_USER=kancha
POSTGRES_PASSWORD=kancha_dev_password
POSTGRES_DB=kancha
POSTGRES_PORT=55432

# Redis
REDIS_PORT=56379

# Backend (NestJS)
BACKEND_PORT=53001
DATABASE_URL=postgres://kancha:kancha_dev_password@postgres:5432/kancha
REDIS_URL=redis://redis:6379

# Frontend (Next.js)
FRONTEND_PORT=53000
# URL del backend vista desde el contenedor del frontend (puerto interno, no cambia)
BACKEND_INTERNAL_URL=http://backend:3001

# pgAdmin (administración web de Postgres)
# Nota: pgAdmin valida el formato del email y rechaza TLDs reservados como .local
PGADMIN_DEFAULT_EMAIL=admin@kancha.dev
PGADMIN_DEFAULT_PASSWORD=kancha_dev_password
PGADMIN_PORT=55050

# RedisInsight (administración web de Redis)
REDISINSIGHT_PORT=55540

# Autenticación
# Secreto HS256 del access token (mínimo 32 caracteres). Valor de ejemplo SOLO para
# desarrollo: genera uno propio con
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=dev-only-change-me-dev-only-change-me-0123456789
# Access token 3 h; refresh token 30 días deslizante con tope absoluto de 90 días
ACCESS_TOKEN_TTL=10800
REFRESH_TOKEN_TTL=2592000
REFRESH_FAMILY_TTL=7776000
# Google OAuth 2.0 (opcional; sin estas tres el botón de Google se oculta).
# Redirect autorizado en Google Cloud: http://localhost:53000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:53000/api/auth/google/callback
# Cookies solo por HTTPS. En local (http) debe ser false; en producción, true.
SECURE_COOKIES=false
# URL pública del frontend (para validar el Origin de los endpoints de Google)
PUBLIC_WEB_URL=http://localhost:53000

# Copia este archivo a .env (cp .env.example .env). Valores solo para desarrollo.

# PostgreSQL
POSTGRES_USER=kancha
POSTGRES_PASSWORD=kancha_dev_password
POSTGRES_DB=kancha
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backend (NestJS)
BACKEND_PORT=3001
DATABASE_URL=postgres://kancha:kancha_dev_password@postgres:5432/kancha
REDIS_URL=redis://redis:6379

# Frontend (Next.js)
FRONTEND_PORT=3000
# URL del backend vista desde el contenedor del frontend
BACKEND_INTERNAL_URL=http://backend:3001
